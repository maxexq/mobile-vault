# Copy to ai/.env and fill in on your own machine. Never commit .env or paste keys in chat.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Models (verified ids, 2026-10-23)
MV_CLAUDE_MODEL=claude-opus-5-5
MV_CLAUDE_EFFORT=high
MV_GEMINI_MODEL=gemini-4-argon
MV_GEMINI_THINKING=high

# Local LLM: any OpenAI-compatible server. Ollama listens on 11434.
# (127.0.0.1:8188 is ComfyUI, not an LLM server.)
MV_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
MV_LOCAL_MODEL=qwen3:4b

# Retrieved context bigger than this (chars) goes to Gemini's 1M window
MV_LONG_CONTEXT_CHARS=60000

# Godot 4.7.2-stable executable for the tester agent (autotest / balance sim)
MV_GODOT_BIN=
