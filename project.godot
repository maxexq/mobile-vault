; Engine configuration file.
; Apocarlypse: Mobile Vault – Idle Survival / Management (Godot 4.7.2-stable, GDScript)

config_version=5

[application]

config/name="Apocarlypse: Mobile Vault"
config/description="Idle survival management in a giant roaming RV vault (2D pixel art, mobile web)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
run/max_fps=60

[autoload]

Data="*res://scripts/autoload/data.gd"
Atlas="*res://scripts/autoload/atlas.gd"
Save="*res://scripts/autoload/save_system.gd"
Features="*res://scripts/autoload/features.gd"
Account="*res://scripts/autoload/account.gd"
Loot="*res://scripts/autoload/loot.gd"
Game="*res://scripts/autoload/game.gd"
Combat="*res://scripts/autoload/combat.gd"
Threat="*res://scripts/autoload/threat.gd"
Lore="*res://scripts/autoload/lore.gd"
Crew="*res://scripts/autoload/crew.gd"
Skills="*res://scripts/autoload/skills.gd"
Mods="*res://scripts/autoload/mods.gd"
Env="*res://scripts/autoload/env.gd"
Expedition="*res://scripts/autoload/expedition.gd"
Inspection="*res://scripts/autoload/inspection.gd"
Encounter="*res://scripts/autoload/encounter.gd"
Meta="*res://scripts/autoload/meta.gd"
Modes="*res://scripts/autoload/modes.gd"
Haul="*res://scripts/autoload/haul.gd"
EngineBay="*res://scripts/autoload/engine_bay.gd"
Synergy="*res://scripts/autoload/synergy.gd"
Trace="*res://scripts/autoload/trace.gd"
Dev="*res://scripts/autoload/dev.gd"
Tutorial="*res://scripts/autoload/tutorial.gd"
Settings="*res://scripts/autoload/settings.gd"
Loc="*res://scripts/autoload/loc.gd"
Cloud="*res://scripts/autoload/cloud.gd"
Telemetry="*res://scripts/autoload/telemetry.gd"
Announce="*res://scripts/autoload/announce.gd"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"
window/handheld/orientation=4

[gui]

fonts/dynamic_fonts/use_oversampling=false
common/snap_controls_to_pixels=true
common/default_scroll_deadzone=8

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.09, 0.08, 0.1, 1)

[internationalization]

locale/include_text_server_data=true
locale/fallback="th"
