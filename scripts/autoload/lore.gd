func _ready() -> void:
	Game.biome_changed.connect(func(_i: int, instant: bool) -> void: sync(not instant))


func _s() -> Dictionary:
	if not Game.s.has("lore"):
		Game.s["lore"] = []
	return Game.s


func is_unlocked(id: String) -> bool:
	return _s().lore.has(id)


func unlock(id: String) -> bool:
	if not ENTRIES.has(id) or is_unlocked(id):
		return false
	_s().lore.append(id)
	unlocked.emit(id)
	return true


func entry_title(id: String) -> String:
	return str(ENTRIES.get(id, {}).get("th", id))


## unlock anything whose condition the current state already meets (called on load / biome change)
func sync(announce: bool = false) -> void:
	if Game.s.is_empty() or not Game.s.has("biome"):
		return
	var before := count_open()
	for id in ENTRIES:
		var at: String = ENTRIES[id].at
		if at == "start":
			unlock(id)
		elif at.begins_with("biome:"):
			var bid := at.substr(6)
			for i in Data.BIOMES.size():
				if Data.BIOMES[i].id == bid and (int(Game.s.biome) >= i or int(Game.s.get("lap", 0)) > 0):
					unlock(id)
		elif at == "lap" and int(Game.s.get("lap", 0)) > 0:
			unlock(id)
	if announce and count_open() > before and before > 0:
		Game.toast.emit("บันทึกใหม่ในสมุดบันทึก: " + entry_title(_s().lore[-1]), "biome")


## logbook listing in display order: [{id, th, text, cat, open}]
func entries() -> Array:
	var out := []
	for id in ENTRIES:
		var e: Dictionary = ENTRIES[id]
		var open := is_unlocked(id)
		out.append({"id": id, "cat": e.cat, "open": open, "th": e.th if open else "??? ยังไม่ค้นพบ",
			"text": e.text if open else _hint(e.at)})
	return out


func _hint(at: String) -> String:
	if at.begins_with("biome:"):
		var bid := at.substr(6)
		for b in Data.BIOMES:
			if b.id == bid:
				return "เดินทางไปถึง %s เพื่อปลดล็อก" % b.th
	if at == "lap":
		return "ขับครบหนึ่งรอบถนนเพื่อปลดล็อก"
	return "ค้นพบได้จากเหตุการณ์ระหว่างทาง"


func count_open() -> int:
	return _s().lore.size()


# ------------------------------------------------------------------ bios
func bio_key(d: Dictionary) -> String:
	if d.has("lore"):
		return str(d.lore)
	return str(NAME_TO_BIO.get(str(d.name), ""))


## {role, text, likes, fear}
func bio(d: Dictionary) -> Dictionary:
	var k := bio_key(d)
	if BIOS.has(k):
		return BIOS[k]
	var h := absi(hash(str(d.id) + str(d.name)))
	var outfit := str(d.variant).split("_")[1] if str(d.variant).count("_") >= 2 else "scav"
	var rid := str(d.variant).trim_prefix("dw_crew_")
	if Crew.is_roster(str(d.variant)) and Data.CREW_ROSTER.has(rid):
		outfit = "roster"
	var role: String = str(Data.CREW_ROSTER[rid].role) if outfit == "roster" else {"army": "อดีตทหาร", "lab": "นักวิทยาศาสตร์", "chef": "พ่อครัว", "medic": "ผู้ช่วยแพทย์", "jumpsuit": "ช่างซ่อม", "scav": "นักคุ้ยซาก", "raider": "อดีตโจร", "builder": "อดีตช่างก่อสร้าง"}.get(outfit, "ผู้รอดชีวิต")
	return {"role": role,
		"text": "%s %s\nเป้าหมาย: %s" % [ORIGINS[h % ORIGINS.size()], TRAITS[(h / 7) % TRAITS.size()], GOALS[(h / 53) % GOALS.size()]],
		"likes": "-", "fear": "-"}


# ------------------------------------------------------------------ chatter
const RECENT_LINES := 12
var _recent_lines: Array = []    # last lines said by anyone, so they don't come straight back


## MV-427: a line for this moment (BARKS kind, or "weather:<id>" for a weather change), in this dweller's own voice when
## they have one (they use it 2 times in 3); "" if the kind has no lines. Shares the recent-lines memory with pick_line.
func pick_bark(kind: String, d: Dictionary, rng: RandomNumberGenerator) -> String:
	var arr: Array = []
	if kind.begins_with("weather:"):
		arr = LINES_WEATHER.get(kind.substr(8), [])
	else:
		arr = BARKS.get(kind, [])
		var own: Array = [] if not d.has("name") else (BARKS_PERSONAL.get(bio_key(d), {}) as Dictionary).get(kind, [])
		if not own.is_empty() and (arr.is_empty() or rng.randf() < 0.67):
			arr = own
	if arr.is_empty():
		return ""
	var line := str(arr[rng.randi() % arr.size()])
	for attempt in 3:
		if not _recent_lines.has(line):
			break
		line = str(arr[rng.randi() % arr.size()])
	_recent_lines.append(line)
	while _recent_lines.size() > RECENT_LINES:
		_recent_lines.pop_front()
	return line


## a context-aware idle line for this dweller ("" if nothing to say)
func pick_line(d: Dictionary, rng: RandomNumberGenerator) -> String:
	var pools: Array = []
	pools.append([LINES_GENERIC, 2])
	var k := bio_key(d)
	if LINES_PERSONAL.has(k):
		pools.append([LINES_PERSONAL[k], 3])
	var slot := int(d.get("room", -1))
	if Game.has_room(slot):
		var rt := str(Game.room(slot).type)
		if Game.is_constructing(slot):
			pools.append([LINES_BUILD, 6])
		elif LINES_ROOM.has(rt):
			pools.append([LINES_ROOM[rt], 3])
	var wid := str(Game.s.get("weather", ""))
	if LINES_WEATHER.has(wid):
		pools.append([LINES_WEATHER[wid], 2])
	var bid := str(Data.biome(int(Game.s.biome)).id)
	if LINES_BIOME.has(bid):
		pools.append([LINES_BIOME[bid], 2])
	for r in ["food", "water", "power"]:
		if float(Game.s.res.get(r, 100.0)) < 15.0:
			pools.append([LINES_LOW[r], 6])
	if float(Game.s.get("hull", 100.0)) < Game.hull_max() * 0.35:
		pools.append([LINES_LOW.hull, 5])
	var ri := Game.squad_role(d)
	if ri >= 0 and ri < Combat.ROLES.size():
		pools.append([LINES_ROLE[Combat.ROLES[ri].id], 4])
	var tod := float(Game.s.get("tod", 0.3))
	if tod > 0.8 or tod < 0.2:
		pools.append([LINES_NIGHT, 2])
	if Game.s.get("pet", false):
		pools.append([LINES_PET, 1])
	var total := 0
	for p in pools:
		total += int(p[1])
	# re-roll a few times so the crew doesn't repeat a line someone said a moment ago
	var line := ""
	for attempt in 4:
		line = ""
		var roll := rng.randi() % maxi(1, total)
		for p in pools:
			roll -= int(p[1])
			if roll < 0:
				var arr: Array = p[0]
				line = str(arr[rng.randi() % arr.size()])
				break
		if line != "" and not _recent_lines.has(line):
			break
	# still the line said just before: take any other line from the same pools (MV-41)
	if line != "" and not _recent_lines.is_empty() and line == _recent_lines[-1]:
		for p in pools:
			for l in p[0]:
				if str(l) != line:
					line = str(l)
					break
			if line != _recent_lines[-1]:
				break
	if line != "":
		_recent_lines.append(line)
		while _recent_lines.size() > RECENT_LINES:
			_recent_lines.pop_front()
	return line
